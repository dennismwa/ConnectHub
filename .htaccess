# ConnectHub front controller and hardening (Apache 2.4 with mod_rewrite)
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Never serve internal folders or source/config files
RewriteRule ^(config|includes|database|storage|app|templates|tools|docs|node_modules|assets/src)(/|$) - [F,L]
# cron/ is private, except the runner itself (for hosts that only offer URL cron jobs; it needs a secret key)
RewriteRule ^cron/(?!run\.php$) - [F,L]
RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|\.env.*|.*\.sql|.*\.md|.*\.log|.*\.sh)$ - [F,L]

# Real files and folders (assets, uploads, installer) are served as they are
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes to the application
RewriteRule ^ index.php [L,QSA]
</IfModule>

# Uncomment to force HTTPS once your certificate is installed
# <IfModule mod_rewrite.c>
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
<FilesMatch "\.(css|js|woff2|svg|png|jpg|jpeg|webp|gif|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "(sw\.js|manifest\.webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_php.c>
php_value upload_max_filesize 12M
php_value post_max_size 40M
php_value max_file_uploads 20
</IfModule>
