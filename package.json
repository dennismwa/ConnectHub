{
  "name": "connecthub",
  "version": "1.0.0",
  "private": true,
  "description": "ConnectHub — build tooling (Tailwind CSS compile). Not needed at runtime.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/src/app.css -o assets/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/src/app.css -o assets/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "chart.js": "^4.5.1",
    "lucide-static": "^1.57.0",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^3.4.17"
  }
}
